rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Any signed-in manager can read the list of managers (Buddies screen)
      allow read: if request.auth != null;

      // You can only create/update YOUR OWN profile:
      // the document id, the userId field and your uid must all match,
      // and name must be a short string.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;

      // Profiles are never deleted from the app
      allow delete: if false;
    }

    // One conversation per pair: chatId = the two uids sorted, joined by "_"
    match /chats/{chatId}/messages/{messageId} {
      // Only the two managers whose uids make up the chatId
      function isMember() {
        return request.auth != null && request.auth.uid in chatId.split('_');
      }

      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.sentAt == request.time;

      // Messages are never edited or deleted
      allow update, delete: if false;
    }
  }
}
